// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  FULL
  MANAGER
  VIEW_ONLY
}

enum BuyerTier {
  A
  B
  C
}

enum OrderStatus {
  NEW
  CONFIRMED
  MANIFESTED
  DELIVERED
  PAID
  CANCELLED
}

enum ARBucket {
  CURRENT   // 0-30 days
  DAYS_30   // 31-60 days
  DAYS_60   // 61-90 days
  DAYS_90   // 90+ days — critical
}

enum NabisAccount {
  HOUSE_BRANDS          // West Coast Treez, PUFF
  CONNECTED_ALIEN_LABS  // Connected, Alien Labs
}

// ─── Core Entities ──────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(VIEW_ONLY)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]
  pendingSends PendingSend[]
}

model Buyer {
  id             String    @id @default(cuid())
  businessName   String
  licenseNumber  String    @unique
  contactName    String
  email          String
  phone          String?
  tier           BuyerTier @default(C)
  paymentTerms   Int       @default(30) // days
  notes          String?
  isActive       Boolean   @default(true)
  requestedAt    DateTime? // For "Request Access" flow from brand site
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
  arRecords      ARRecord[]
  dropAlerts     DropEventBuyerNotification[]
}

model Batch {
  id              String       @id @default(cuid())
  nabisId         String       @unique // ID from Nabis
  nabisAccount    NabisAccount
  sku             String
  batchNumber     String
  productName     String
  brand           String
  category        String?      // flower, pre-roll, vape, etc.
  harvestDate     DateTime?
  labResultDate   DateTime?
  thcPct          Float?
  cbdPct          Float?
  qtyOnHand       Int          @default(0) // cases
  caseSize        Int          @default(1) // units per case
  unitPrice       Decimal      @db.Decimal(10, 2)
  casePrice       Decimal      @db.Decimal(10, 2)
  isActive        Boolean      @default(true)
  firstSeenAt     DateTime     @default(now())
  lastSyncedAt    DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orderLines      OrderLine[]
  dropEvents      DropEvent[]
  ageAlerts       BatchAgeAlert[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid()) // human-readable reference
  buyerId         String
  buyer           Buyer       @relation(fields: [buyerId], references: [id])
  status          OrderStatus @default(NEW)
  
  // Buyer details at time of order (snapshot — buyer may change)
  buyerBusinessName  String
  buyerLicenseNumber String
  buyerContactName   String
  buyerEmail         String
  buyerPhone         String?
  
  notes           String?
  subtotal        Decimal     @db.Decimal(10, 2)
  
  // Lifecycle timestamps
  placedAt        DateTime    @default(now())
  confirmedAt     DateTime?
  manifestedAt    DateTime?
  deliveredAt     DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  
  // Google Sheets tracking
  sheetRowWritten Boolean     @default(false)
  sheetRowError   String?     // Non-null means write failed — surfaced in desk
  
  // Source of order
  source          String      @default("menu") // menu | concierge | desk

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines           OrderLine[]
  arRecord        ARRecord?
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])

  // Snapshot at time of order
  sku           String
  batchNumber   String
  productName   String
  brand         String
  caseCount     Int
  unitPrice     Decimal @db.Decimal(10, 2)
  casePrice     Decimal @db.Decimal(10, 2)
  lineTotal     Decimal @db.Decimal(10, 2)
  
  createdAt   DateTime @default(now())
}

model ARRecord {
  id            String    @id @default(cuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  buyerId       String
  buyer         Buyer     @relation(fields: [buyerId], references: [id])
  
  invoicedAt    DateTime  @default(now())
  dueDate       DateTime
  amountDue     Decimal   @db.Decimal(10, 2)
  amountPaid    Decimal   @default(0) @db.Decimal(10, 2)
  bucket        ARBucket  @default(CURRENT)
  
  lastChaseAt   DateTime?
  chaseCount    Int       @default(0)
  
  // Jurisdiction deadline tracking (CA/NY — surfaces clock, never legal advice)
  jurisdictionDeadline    DateTime?
  jurisdictionNote        String?   // Plain-language note, not legal position
  
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DropEvent {
  id            String    @id @default(cuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id])
  detectedAt    DateTime  @default(now())
  dropWindowEnd DateTime? // If a timed drop window applies
  
  notifiedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  
  notifications DropEventBuyerNotification[]
  pendingSends  PendingSend[]
}

model DropEventBuyerNotification {
  id          String     @id @default(cuid())
  dropEventId String
  dropEvent   DropEvent  @relation(fields: [dropEventId], references: [id])
  buyerId     String
  buyer       Buyer      @relation(fields: [buyerId], references: [id])
  tier        BuyerTier
  sentAt      DateTime?
  
  @@unique([dropEventId, buyerId])
}

model BatchAgeAlert {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id])
  ageAtAlert    Int      // days since harvest/lab result
  severity      String   // warn | escalate | critical
  suggestedAction String // "Price drop", "Push to tier-B", "Bundle promo", etc.
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
}

// Staged outbound sends — A human always dispatches, never auto-sent
model PendingSend {
  id          String    @id @default(cuid())
  type        String    // "drop_alert" | "ar_chase" | "batch_age"
  
  // Recipient
  recipientEmail String
  recipientName  String
  
  // Draft
  subject     String
  bodyHtml    String
  bodyText    String
  
  // Relations (optional — one will be set)
  dropEventId String?
  dropEvent   DropEvent? @relation(fields: [dropEventId], references: [id])
  
  // Lifecycle
  draftedAt   DateTime  @default(now())
  reviewedAt  DateTime?
  sentAt      DateTime?
  sentById    String?
  sentBy      User?     @relation(fields: [sentById], references: [id])
  cancelledAt DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // "order.created", "order.status_changed", "send.dispatched", etc.
  entityType  String
  entityId    String
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}
