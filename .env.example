# Environment variables for lbs. Revenue OS
# Copy this file to .env.local and fill in values
# NEVER commit real values to the repository

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://lbs_user:lbs_pass@localhost:5432/lbs_revenue_os"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Nabis API ───────────────────────────────────────────────────────────────
# These credentials MUST arrive via one-time secret link or live call.
# NEVER put real values here. NEVER commit real values to any repo, ticket, or log.
NABIS_ACCOUNT_1_API_KEY=""
NABIS_ACCOUNT_1_LABEL="house-brands"
NABIS_ACCOUNT_2_API_KEY=""
NABIS_ACCOUNT_2_LABEL="connected-alien-labs"
NABIS_BASE_URL="https://api.getnabis.com/graphql/admin"
NABIS_POLL_INTERVAL_MS="900000"

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Service account JSON key (base64 encoded)
GOOGLE_SERVICE_ACCOUNT_KEY_B64=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_ORDERS_TAB="Orders"
GOOGLE_SHEET_LINE_ITEMS_TAB="Line Items"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="lbs. Distribution <orders@lbsdist.com>"

# ─── Vapi (Concierge Voice) ──────────────────────────────────────────────────
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""

# ─── App Config ──────────────────────────────────────────────────────────────
APP_ENV="development"
MOCK_NABIS="true"











GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbw0YYAWhdb26YRe0I8uuV1MkEiYmb5B1Mw6C_x7WQsu38bbwy3Ov-iM5ICFbssoEpsDtA/exec"
